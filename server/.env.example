# Copy this file to server/.env and edit the values
PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/freshcart
JWT_SECRET=change-this-to-a-long-random-string
# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# Admin account created by "npm run db:setup"
ADMIN_EMAIL=admin@freshcart.com
ADMIN_PASSWORD=Admin@12345
